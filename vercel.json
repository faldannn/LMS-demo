{
  "version": 2,
  "framework": null,
  "outputDirectory": "public",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "public"
      }
    },
    {
      "src": "api/index.php",
      "use": "vercel-php@0.7.3"
    }
  ],
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/build/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "LMS Sekolah Digital",
    "APP_ENV": "production",
    "APP_DEBUG": "true",
    "APP_KEY": "base64:biqCuYXu4iPsb4IKWrlvFxV5cy6odGJV2AwAyk9+rAU=",
    "APP_PACKAGES_CACHE": "/tmp/storage/bootstrap/cache/packages.php",
    "APP_SERVICES_CACHE": "/tmp/storage/bootstrap/cache/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "DB_CONNECTION": "mysql",
    "DB_HOST": "gateway01.ap-northeast-1.prod.aws.tidbcloud.com",
    "DB_PORT": "4000",
    "DB_DATABASE": "lms_demo",
    "DB_USERNAME": "xeGakznEYY7uFXn.root",
    "DB_PASSWORD": "wE8wp0ZaE312350p",
    "MYSQL_ATTR_SSL_CA": "true",
    "MYSQL_ATTR_SSL_VERIFY_SERVER_CERT": "false",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}
